PORT=3000
# Explicit browser origins; never use *.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
# SQLite file is private and persisted. Requires Node.js 24.10+.
DATABASE_PATH=./data/hillalert.sqlite
# Optional deployment-owned JSON arrays; no unverified sample numbers are shipped.
RESOURCES_FILE=
CONTACTS_FILE=
